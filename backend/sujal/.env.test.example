# Copy this file to .env.test (in your backend project root, next to
# your real .env) and fill in real values from your local setup.
#
# Only 3 things are needed - every test creates its own users, vendors,
# amenities, etc. on the fly via the API using the super admin below,
# so you don't need to hand-build a big fixture set.

# A society id that already exists in your teammate's societies table
TEST_SOCIETY_ID=

# A unit id that already exists in your teammate's units table
# (needed by tests/amenity-concurrency.test.js)
TEST_UNIT_ID=

# Credentials for a real SUPER_ADMIN user (from your seed-super-admin script)
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=
