# Copy to .env for local development. Never commit a real .env file.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housing_society_test
DB_USER=postgres
DB_PASSWORD=replace_me
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP password reset and notification email delivery.
# Use the manager-provided Gmail account and a Google App Password (not the
# account's regular password). Set the same values in local .env and deployment.
GMAIL_SMTP_USER=manager-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=

RATE_LIMIT_AUTH_MAX=100

