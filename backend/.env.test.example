# Copy to .env.test and set values for a dedicated test database.
# Tests create and modify records. Do not point this at production or your
# normal development database.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housing_society_test
DB_USER=postgres
DB_PASSWORD=replace_with_local_postgres_password
JWT_ACCESS_SECRET=replace_with_a_long_random_test_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_test_secret

# Existing IDs and admin credentials required by integration tests.
TEST_SOCIETY_ID=
TEST_UNIT_ID=
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=
